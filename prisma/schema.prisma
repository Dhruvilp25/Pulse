// Pulse data model. Every table except Project is scoped by projectId — see
// CLAUDE.md: "Every single DB query must be scoped by projectId".
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id          String   @id @default(cuid())
  name        String
  clerkUserId String // the Clerk user that owns this project
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  apiKeys ApiKey[]
  events  Event[]
  queries Query[]

  @@index([clerkUserId])
}

model ApiKey {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name       String? // optional human label
  prefix     String    @unique // shown to the user; used to look the key up at ingest
  hashedKey  String // bcrypt hash of the full key — plaintext is never stored
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([projectId])
}

model Event {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name       String
  properties Json     @default("{}") // JSONB
  timestamp  DateTime @default(now()) // when the event occurred
  createdAt  DateTime @default(now()) // when it was ingested

  @@index([projectId, name])
  @@index([projectId, timestamp])
}

model Query {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name         String? // optional saved-query label
  question     String // natural-language question
  generatedSql String // SQL produced by the NL-to-SQL step
  createdAt    DateTime  @default(now())
  lastRunAt    DateTime?

  @@index([projectId])
}
